# Server Configuration
PORT=5000
NODE_ENV=development
# Public origin of THIS api. Set it to the real domain in production
# (e.g. https://api.myiq-test.com). Swagger derives its server list from the
# request rather than this, so stale values no longer break /docs — but the
# demo harness falls back to it, so keep it accurate.
APP_URL=http://localhost:5000
# Superseded by FUNNEL_URL below, which is still read if this is all that is set.
FRONTEND_URL=http://localhost:3000

# Where the quiz funnel is served. Every link in an email and every document
# link in the members' area is built from it — the IQ certificate, the detailed
# report and the career report all live here.
#
# Set this per environment. Left at the localhost default, a customer in
# production receives a certificate link pointing at their own machine.
FUNNEL_URL=https://myiq-test.com

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=iq_funnel
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# Static funnel test harness served at /app (development only)
DEMO_UI_ENABLED=false

# Security & Encryption
ENCRYPTION_KEY=your_secure_encryption_secret_key_here
# Leave empty to disable the x-api-key check (development convenience)
API_KEY=

# Admin Panel Authentication
# Sessions are long-lived on purpose (60 days). Revoke access by setting the
# admin's users.status to anything other than 'active' — checked on every request.
ADMIN_JWT_SECRET=replace_with_a_long_random_admin_jwt_secret
ADMIN_JWT_EXPIRES_IN=60d
ADMIN_BCRYPT_ROUNDS=10

# Email verification (reoon.com)
# Off by default — turn on once REOON_API_KEY is set.
EMAIL_VERIFICATION_ENABLED=false
REOON_API_KEY=
REOON_API_URL=https://emailverifier.reoon.com/api/v1/verify
# 'quick' (fast, syntax/MX/disposable) or 'power' (adds SMTP checks, slower)
REOON_MODE=quick
# Reoon overall_score at or above which the email counts as verified (0-100)
EMAIL_VERIFICATION_MIN_SCORE=80
EMAIL_VERIFICATION_TIMEOUT_MS=8000

# Email sending (ZeptoMail by Zoho)
# The only outbound mail transport. Off by default — turn on once the token and
# a verified sender address are in place.
ZEPTOMAIL_ENABLED=false
# Must match the datacenter your ZeptoMail account lives in, or the token is
# rejected with SERR_157 "Invalid API Token found":
#   .com = global, .eu = Europe, .in = India, .com.au = Australia, .ca = Canada
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Copy the whole value ZeptoMail shows, including the "Zoho-enczapikey " prefix
ZEPTOMAIL_TOKEN=
# Must be on a domain verified in your ZeptoMail account
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=MyIQTest
# Optional: where replies go, if not the sender address
ZEPTOMAIL_REPLY_TO=
ZEPTOMAIL_TRACK_OPENS=true
ZEPTOMAIL_TRACK_CLICKS=true
EMAIL_REQUEST_TIMEOUT_MS=10000
# Renders and logs each message without handing it to the provider — a
# developer switch for testing the sequence without sending real mail
EMAIL_DRY_RUN=false

# Optional: render a template inside ZeptoMail instead of in this repo.
# Name the variable after the template id from src/emails/registry.ts, in
# uppercase. The app then posts the template's declared parameters as
# merge_info and ZeptoMail renders its own hosted design.
#   ZEPTOMAIL_TEMPLATE_MARKETING_REMINDER_DAY1=2518b.53ab...

# Transactional email (welcome + report ready)
# Sent to paying customers: the welcome with their brain-training credentials
# when the first sale settles, and the report-ready notice when they finish the
# funnel. Off by default.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_MAX_ATTEMPTS=3

# The brain training programme the subscription unlocks. The welcome email
# sends the customer's credentials for this sign-in page.
BRAIN_TRAINING_NAME=Brain Training Program
# Leave empty to fall back to FRONTEND_URL
BRAIN_TRAINING_LOGIN_URL=

# Email marketing sequence (abandoned checkout)
# This switch decides whether the schedule is registered at all. Which steps
# run, at what delay, with which discount code and template, lives in the
# email_marketing_settings / email_marketing_steps tables and is edited from
# the admin panel.
EMAIL_MARKETING_ENABLED=false
# Every 5 minutes
EMAIL_MARKETING_CRON=*/5 * * * *
EMAIL_MARKETING_TIMEZONE=UTC
# A step claimed by a runner that then died is released after this many minutes
EMAIL_MARKETING_STUCK_CLAIM_MINUTES=30

# Discount codes are NOT configured here — they live in data/discount-codes.json
# Marketing sequence steps are NOT configured here either — they live in the
# email_marketing_settings / email_marketing_steps tables, seeded on first boot

# Subscription (created on the first sale, charged to the same saved card)
# Off by default — turn on once the Price ids below are real.
SUBSCRIPTION_ENABLED=false
# Static Stripe Price ids (Products -> your recurring price -> price_...)
STRIPE_SUB_PRICE_ID_JA=
STRIPE_SUB_PRICE_ID_EN=

# Currency Rate Sync (exchangeratesapi.io)
# Master switch for the scheduled exchange-rate refresh
CURRENCY_SYNC_ENABLED=false
EXCHANGERATES_API_KEY=da4a6b1c0d87bb05597ddc4e3ffde438
EXCHANGERATES_API_URL=https://api.exchangeratesapi.io/v1
# Base requested from the provider. The free plan only issues EUR quotes, so we
# fetch EUR and rebase everything on GBP ourselves before storing.
EXCHANGERATES_API_BASE=EUR
# Every 12 hours (00:00 and 12:00)
CURRENCY_SYNC_CRON=0 */12 * * *
CURRENCY_SYNC_TIMEZONE=UTC
# Run one refresh immediately on boot instead of waiting for the first tick
CURRENCY_SYNC_ON_STARTUP=false
# Note: there is no currency allowlist. Every currency the provider returns is
# stored, with GBP as the base (rate 1), so the table is a full reference set
# and adding a currency needs no config change.
CURRENCY_REQUEST_TIMEOUT_MS=10000

# Default Funnel Settings
DEFAULT_LANGUAGE=ja
DEFAULT_CURRENCY=JPY

# ---------------------------------------------------------------------------
# Boost My IQ — the members' area (boost.myiq-test.com)
# ---------------------------------------------------------------------------
# Member session secret. MUST be different from ADMIN_JWT_SECRET: one shared
# secret would make an admin token a valid member token and, far worse, a
# member token a valid admin token.
BOOST_JWT_SECRET=change_me_to_a_long_random_string
# "Keep me signed in" ticked, and unticked, respectively.
BOOST_JWT_EXPIRES_IN=60d
BOOST_JWT_SHORT_EXPIRES_IN=12h
# Where the members' app is served. Password reset links are built from this.
BOOST_APP_URL=https://boost.myiq-test.com
# Origins allowed to call the members' API with credentials. A credentialed
# request cannot be answered with `Access-Control-Allow-Origin: *`, so this is
# an explicit list, comma separated — not a wildcard.
BOOST_APP_ORIGINS=https://boost.myiq-test.com,http://localhost:5173
BOOST_PASSWORD_RESET_TTL_MINUTES=60

# Already used by the welcome email — point it at the members' sign-in page so
# the credentials it delivers land somewhere useful.
BRAIN_TRAINING_LOGIN_URL=https://boost.myiq-test.com/login
